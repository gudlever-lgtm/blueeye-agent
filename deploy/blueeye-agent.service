[Unit]
Description=BlueEyes monitoring agent
Documentation=https://github.com/gudlever-lgtm/blueeye-agent
After=network-online.target
Wants=network-online.target
# NO start limit. A rate limit here means systemd eventually stops trying, and a
# monitoring agent that has given up is indistinguishable from one that was never
# installed: no connection, therefore no server-driven recovery, therefore a shell
# on a host that is not supposed to need one. The two failures a limit was meant
# to contain are handled where they happen instead — a bad release by the
# ExecStartPre guard below (after 3 starts without the agent confirming the
# release it repoints `current` at the previous one), and a refused token by the
# agent itself (it pauses and re-dials on a long timer rather than exiting).
# A restart loop is still visible in `systemctl status` and the journal.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
# Runs as root: a self-update restarts this service (systemctl) and a self-delete
# removes the unit + /opt files — both need privileges. To run unprivileged
# instead, add polkit rules for `systemctl restart/stop blueeye-agent` + sudo for
# uninstall.sh, then set User=/Group= here.
WorkingDirectory=/opt/blueeye-agent/current
# Run from the `current` symlink so a signed update can ATOMICALLY swap the
# release underneath without rewriting a live tree.
# Roll back a release that never confirmed itself. The guard is plain sh living
# OUTSIDE releases/, so a release too broken for Node to parse is still
# recoverable; the agent installs/refreshes it on startup (src/release/
# releaseGuard.js). The leading '-' means a missing guard never blocks a start.
ExecStartPre=-/bin/sh /opt/blueeye-agent/bin/release-guard.sh /opt/blueeye-agent/releases /opt/blueeye-agent/current 3
ExecStart=/usr/bin/node /opt/blueeye-agent/current/src/index.js
# always, not on-failure: the agent exits 0 on SIGTERM (a stop is honoured) and
# non-zero on anything it cannot recover from, but a clean exit that nobody asked
# for — a crash guard that shut down tidily, a Node that exited on an unhandled
# rejection — would otherwise leave the host unmonitored and silent.
Restart=always
RestartSec=5

# Provisioning. The token, config and action log live OUTSIDE the swappable release
# dir so they survive updates — ExecStart runs through the `current` symlink, so a
# default config path would resolve into releases/<version>/ (build-release.sh
# excludes the config) and be abandoned on the next atomic swap. BLUEEYE_RELEASE_-
# PUBLIC_KEY (base64-of-PEM) — the signed-update trust anchor — is set via a drop-in.
Environment=BLUEEYE_SERVER_URL=https://server.example
Environment=BLUEEYE_TOKEN_PATH=/var/lib/blueeye-agent/token
Environment=BLUEEYE_AGENT_CONFIG=/var/lib/blueeye-agent/config.json
Environment=BLUEEYE_ACTION_LOG=/var/log/blueeye-agent/actions.log
Environment=BLUEEYE_RELEASES_DIR=/opt/blueeye-agent/releases
Environment=BLUEEYE_CURRENT_LINK=/opt/blueeye-agent/current

# Command authenticity. Without these, a privileged push (update / delete /
# install-tool) is authenticated ONLY by the WebSocket session: anything holding
# this agent's socket can reconfigure or wipe the host. With them, the server
# must also sign the command with the release key this agent pins, so the agent
# can tell "the server asked" from "something holding a socket asked".
#
# Commented out rather than on, because turning them on against a server that
# has no managed signing key yet stops one-click updates working — and an agent
# in the field cannot be un-stuck without host access. Turn them on once
# Settings → Updates shows a signing key, which is also when the server starts
# signing automatically (services/commandSigner.js). The `rekey` command is
# strict regardless; it does not need a flag, because it is the one command that
# replaces what every later signature is checked against.
#Environment=BLUEEYE_REQUIRE_SIGNED_COMMANDS=1
#Environment=BLUEEYE_REQUIRE_SIGNED_UPDATES=1

# Break-glass ONLY: lets an unsigned `rekey` replace a trust anchor this host
# already holds. Needed exactly once, on a fleet whose server lost its signing
# key and therefore cannot sign the rotation. Leave it off; remove it again
# after the recovery. See src/commandAuth.js.
#Environment=BLUEEYE_ALLOW_UNSIGNED_REKEY=1

# Sandboxing. The service runs as root (see above), so these bound what a bug —
# or a server that pushes something it shouldn't — can reach from inside the
# agent process. Everything here is compatible with the three privileged things
# the agent legitimately does: self-update (tar + npm under /opt, then
# `systemctl restart`), self-delete (uninstall.sh removing /opt + /var/lib +
# /var/log), and install-tool (the host package manager).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# AF_NETLINK is required: `ss` (connection table) and `ethtool` (NIC inventory)
# both talk netlink. AF_UNIX covers the D-Bus call behind `systemctl`.
#
# AF_PACKET is what libpcap opens to capture, so `tcpdump` cannot start without
# it — the transaction header capture (src/capture/) would refuse on every host
# running under this unit. It is a real widening of the sandbox and is listed
# last so it is the obvious line to remove on a host that does not want the
# feature: dropping it leaves everything else working, and the agent then
# reports `capabilities.unavailable.capture` instead of failing silently.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# State the agent writes (token, config, action log) stays owner-only.
UMask=0077
# A core dump would contain the agent token in cleartext.
LimitCORE=0
#
# Deliberately NOT set, and why — do not "complete" this list without checking:
#   ProtectSystem=      install-tool writes /usr (package manager) and the
#                       hsflowd manager writes /etc/hsflowd.conf.
#   ProcSubset=pid      the proc traffic source reads /proc/net/dev and
#                       /proc/net/arp, which ProcSubset=pid hides.
#   CapabilityBoundingSet / SystemCallFilter=@system-service
#                       a package manager needs broad capabilities and syscalls;
#                       pinning them here breaks install-tool on some distros.
#   PrivateDevices=     dpkg maintainer scripts on some distros create device
#                       nodes.
# If a package install ever fails under this unit, ProtectKernelTunables= is the
# first line to drop (a maintainer script running `sysctl -w`).

[Install]
WantedBy=multi-user.target
